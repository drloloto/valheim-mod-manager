{
	"name": "vmm",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.3",
	"engines": {
		"node": ">=22.18.0"
	},
	"devDependencies": {
		"vite-plus": "catalog:",
		"typescript": "catalog:"
	},
	"trustedDependencies": [
		"esbuild"
	],
	"scripts": {
		"prepare": "vp config",
		"mock": "pwsh apps/client/dev/seed-dev-data.ps1 && cd apps/client && VITE_MOCK_TAURI=1 bun run dev:app",
		"mock:seed": "pwsh apps/client/dev/seed-dev-data.ps1 -Reset",
		"mock:web": "cd apps/client && VITE_MOCK_TAURI=1 vp dev --strictPort",
		"mock:shot": "cd apps/client && node dev/screenshot.mjs",
		"mock:audit": "cd apps/client && node dev/audit-pages.mjs"
	},
	"workspaces": {
		"packages": [
			"apps/client",
			"apps/companion",
			"apps/companion/ui",
			"packages/*"
		],
		"catalog": {
			"@fontsource-variable/archivo": "^5.3.0",
			"@fontsource-variable/jetbrains-mono": "^5.3.0",
			"@internationalized/date": "^3.12.4",
			"@lucide/svelte": "^1.64.0",
			"@sveltejs/adapter-static": "^4.0.0",
			"@sveltejs/kit": "^3.1.0",
			"@sveltejs/vite-plugin-svelte": "^7.3.1",
			"@tailwindcss/vite": "^4.3.3",
			"bits-ui": "^2.20.2",
			"clsx": "^2.1.1",
			"prettier": "^3.9.9",
			"prettier-plugin-svelte": "^4.1.1",
			"prettier-plugin-tailwindcss": "^0.8.1",
			"shadcn-svelte": "^1.7.1",
			"svelte": "^5.57.3",
			"svelte-check": "^4.7.7",
			"svelte-sonner": "^1.2.2",
			"tailwind-merge": "^3.7.0",
			"tailwind-variants": "^3.3.1",
			"tailwindcss": "^4.3.3",
			"tw-animate-css": "^1.4.0",
			"typescript": "~6.0.3",
			"vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
			"vite-plus": "1.4.0"
		}
	},
	"overrides": {
		"vite@*": "catalog:"
	}
}
