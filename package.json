{
	"name": "valheim-mod-manager",
	"private": true,
	"version": "0.3.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"tauri": "tauri",
		"dev:app": "tauri dev --config src-tauri/tauri.dev.conf.json",
		"build:dev-app": "tauri build --debug --no-bundle --config src-tauri/tauri.dev.conf.json",
		"test": "vitest run",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"tauri:build:local": "tauri build --config src-tauri/tauri.local.conf.json",
		"tauri:build:portable": "tauri build --config src-tauri/tauri.local.conf.json --no-bundle && node scripts/portable.mjs"
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.4",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tauri-apps/cli": "^2.12.1",
		"@tsconfig/svelte": "^5.0.8",
		"@types/node": "^26.6.4",
		"esbuild": "^0.28.2",
		"jsdom": "^30.1.2",
		"paneforge": "^1.0.2",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.3"
	},
	"dependencies": {
		"@fontsource-variable/archivo": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@lucide/svelte": "^1.54.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/api": "^2.12.2",
		"@tauri-apps/plugin-clipboard-manager": "^2.4.1",
		"@tauri-apps/plugin-deep-link": "^2.6.1",
		"@tauri-apps/plugin-dialog": "^2.8.1",
		"@tauri-apps/plugin-opener": "^2.7.0",
		"@tauri-apps/plugin-process": "^2.4.0",
		"@tauri-apps/plugin-updater": "^2.13.2",
		"bits-ui": "^2.19.5",
		"clsx": "^2.1.1",
		"dompurify": "^3.4.16",
		"marked": "^18.1.0",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3"
	},
	"description": "Fast, standalone mod manager for Valheim on Windows (Thunderstore, BepInEx, r2modman-compatible profiles).",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/drloloto/valheim-mod-manager.git"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
