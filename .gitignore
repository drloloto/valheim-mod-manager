# Dependencies and build output, at any depth (apps/*, packages/*)
node_modules/
.svelte-kit/
**/src-tauri/target/
**/src-tauri/gen/
apps/*/build/
apps/*/ui/build/
packages/*/dist/
dist/
dist-ssr/
*.local
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Editors
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Lockfiles of other package managers (pnpm is the workspace's package manager)
package-lock.json
bun.lock
bun.lockb
yarn.lock

# Vite+ task cache
.vite-task/
node_modules/.vite-task/

# The docker test stack: secrets and runtime state stay local
test/.env
test/config/
test/data/
test/backups/

# Local experiments and design-sync scratch
/spike/
/.ds-sync/
/ds-bundle/
/.design-sync/.cache/
