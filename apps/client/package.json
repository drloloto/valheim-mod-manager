{
	"name": "@vmm/client",
	"private": true,
	"version": "0.4.1",
	"type": "module",
	"scripts": {
		"dev": "vp dev",
		"preview": "vp preview",
		"prepare": "svelte-kit sync || echo ''",
		"tauri": "tauri",
		"dev:app": "tauri dev --config src-tauri/tauri.dev.conf.json",
		"build:dev-app": "tauri build --debug --no-bundle --config src-tauri/tauri.dev.conf.json",
		"tauri:build:local": "tauri build --config src-tauri/tauri.local.conf.json",
		"tauri:build:portable": "tauri build --config src-tauri/tauri.local.conf.json --no-bundle && node scripts/portable.mjs"
	},
	"devDependencies": {
		"@internationalized/date": "catalog:",
		"@sveltejs/adapter-static": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tauri-apps/cli": "^2.12.1",
		"@tsconfig/svelte": "^5.0.8",
		"@types/node": "^26.6.4",
		"esbuild": "^0.28.2",
		"jsdom": "^30.1.2",
		"paneforge": "^1.0.2",
		"shadcn-svelte": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tw-animate-css": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	},
	"dependencies": {
		"@fontsource-variable/archivo": "catalog:",
		"@fontsource-variable/jetbrains-mono": "catalog:",
		"@lucide/svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@tauri-apps/api": "^2.12.2",
		"@tauri-apps/plugin-clipboard-manager": "^2.4.1",
		"@tauri-apps/plugin-deep-link": "^2.6.1",
		"@tauri-apps/plugin-dialog": "^2.8.1",
		"@tauri-apps/plugin-opener": "^2.7.0",
		"@tauri-apps/plugin-process": "^2.4.0",
		"@tauri-apps/plugin-updater": "^2.13.2",
		"bits-ui": "catalog:",
		"clsx": "catalog:",
		"dompurify": "^3.4.16",
		"marked": "^18.1.0",
		"svelte-sonner": "catalog:",
		"tailwind-merge": "catalog:",
		"tailwind-variants": "catalog:",
		"tailwindcss": "catalog:",
		"@vmm/ui": "workspace:*"
	},
	"description": "Fast, standalone mod manager for Valheim on Windows (Thunderstore, BepInEx, r2modman-compatible profiles).",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/drloloto/valheim-mod-manager.git"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
