# Copy to test/.env (git-ignored). The test stack never reaches the internet; the tunnel services are disabled
# in docker-compose.override.yaml, their variables only have to exist.
FRP_TOKEN=unused
PLAYIT_SECRET_KEY=unused

# A throwaway GitHub token (gist scope) for the gist sync tests. Never a real account's token.
COMPANION_GIST_TOKEN=

# Loads the companion's compose file next to the game's (what `setup` writes on a real server).
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yaml:docker-compose.override.yaml:compose.companion.yaml
